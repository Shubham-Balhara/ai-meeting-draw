# AI Meeting Draw — every variable is OPTIONAL: with zero config the app still runs
# (file storage, AI off). Copy to .env and fill in what you need.

# Host port for docker compose (default 8000)
# AI_MEETING_DRAW_PORT=8000

# Python log level: DEBUG, INFO, WARNING, ERROR, or CRITICAL
LOG_LEVEL=DEBUG

# Postgres — docker compose sets this itself; only needed when running the
# backend outside Docker. Absent → data persists to backend/storage/ files.
# DATABASE_URL=postgresql://ai_meeting_draw:ai_meeting_draw@127.0.0.1:5432/ai_meeting_draw

# CORS allowlist for dev tooling (prod is same-origin, not needed)
# AI_MEETING_DRAW_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173

# ---- Shared AI pool (OPTIONAL — most self-hosters skip this) ---------------
# Users bring their own AI key in the app (BYOK, stored in their browser and
# sent per-request — the server never stores it). Only set these if you want
# to sponsor a shared AI pool for all visitors.
#DATABRICKS_HOST=
#DATABRICKS_TOKEN=
#DATABRICKS_CONFIG_PROFILE=
#DATABRICKS_CLAUDE_ENDPOINT=

# ---- Free AI pool via OpenRouter (OPTIONAL) ---------------------------------
# Key-less visitors ride this shared pool of OpenRouter ":free" models when
# set (BYOK users are unaffected). Fails closed behind per-IP rate limits and
# a global daily budget. POOL_MODEL overrides the default model list
# (comma-separated, same format as services/pool.py DEFAULT_POOL_MODEL).
#OPENROUTER_POOL_KEY=
#POOL_MODEL=
#POOL_RPM_PER_IP=
#POOL_RPD_PER_IP=
#POOL_DAILY_BUDGET=

# Optional Cloudflare Turnstile in front of the free pool: setting the secret
# makes pool requests require an X-Turnstile-Token header; the site key is
# served to the SPA via GET /api/config.
#TURNSTILE_SECRET=
#TURNSTILE_SITE_KEY=

# ---- Privacy-friendly analytics (OPTIONAL) ----------------------------------
# Set PLAUSIBLE_DOMAIN to inject the Plausible snippet into the SPA shell;
# PLAUSIBLE_SRC overrides the script host for self-hosted Plausible.
#PLAUSIBLE_DOMAIN=
#PLAUSIBLE_SRC=

# ---- S3/R2 object storage for log shipping (OPTIONAL) ----------------------
#S3_ENDPOINT_URL=
#S3_BUCKET=
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
#S3_REGION=auto

# ---- Meeting audio, transcription and intelligence ------------------------
# The existing meeting-audio/backend/.env is read as a temporary compatibility
# fallback. Prefer moving these values into this file for the unified backend.
STT_PROVIDER=whisper
WHISPERX_PYTHON=/absolute/path/to/whisperx/.venv-whisperx/bin/python
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en
WHISPERX_BATCH_SIZE=4
WHISPERX_VAD_METHOD=pyannote
WHISPERX_VAD_ONSET=0.5
WHISPERX_VAD_OFFSET=0.363
STT_INITIAL_PROMPT=A software system design meeting discussing services, APIs, databases, caches, queues, events, protocols, and cloud infrastructure.
STT_HOTWORDS=Kafka,Kubernetes,PostgreSQL,Redis,gRPC,GraphQL,WebSocket,microservice,API gateway
GEMINI_API_KEY=
GEMINI_BACKEND=developer
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
SEGMENT_SECONDS=8
SEGMENT_OVERLAP_SECONDS=1
MIN_FINAL_SEGMENT_SECONDS=0.5
# Utterance-aware segmentation. Fixed SEGMENT_* values remain as the fallback
# when this is disabled.
UTTERANCE_VAD_ENABLED=true
VAD_FRAME_MS=20
VAD_ENERGY_THRESHOLD=350
VAD_ONSET_MS=100
VAD_OFFSET_MS=600
VAD_PRE_SPEECH_MS=300
VAD_MIN_SPEECH_MS=250
VAD_MAX_UTTERANCE_SECONDS=25
TRANSCRIPTION_WORKERS=2
TRANSCRIPTION_QUEUE_SIZE=8

INTELLIGENCE_ENABLED=true
# gemini | grok (xAI) | groq (GroqCloud) | qwen (local Ollama)
INTELLIGENCE_PROVIDER=qwen
INTELLIGENCE_MODEL=gemini-3.1-flash-lite
# Defaults to GEMINI_API_KEY for Gemini. Use the matching provider key for Grok/Groq. Empty for Qwen.
INTELLIGENCE_API_KEY=
# Grok: https://api.x.ai/v1 ; Groq: https://api.groq.com/openai/v1 ; Qwen: http://127.0.0.1:11434
INTELLIGENCE_BASE_URL=http://127.0.0.1:11434
OLLAMA_NUM_CTX=16384
OLLAMA_THINK=true
INTELLIGENCE_TIMEOUT_SECONDS=300
INTELLIGENCE_RETRY_ATTEMPTS=3
INTELLIGENCE_WINDOW_SECONDS=20
INTELLIGENCE_MIN_NEW_CHARS=120
INTELLIGENCE_CONTEXT_SEGMENTS=30

# Optional transcript cleanup. Keep disabled until the correction workflow is
# evaluated with your meeting vocabulary.
ENABLE_TRANSCRIPT_CORRECTION=false
CORRECTION_PROVIDER=qwen
CORRECTION_MODEL=qwen2.5:7b
CORRECTION_CONFIDENCE_THRESHOLD=0.78
CORRECTION_QUEUE_SIZE=32
# The verified stateful architecture agent and diagram mapper.
ENABLE_ARCHITECTURE_AGENT_V2=true
ENABLE_DIAGRAM_MAPPER_V2=true
DEFAULT_BACKEND_STYLE=microservice
DEFAULT_SYNC_PROTOCOL=REST/HTTPS
ALLOW_GENERIC_ASYNC_INFRASTRUCTURE=true
DEFAULT_PROVENANCE_VISIBILITY=true
# Never enable outside controlled local evaluation; prompts may contain meeting content.
PROMPT_LOGGING=false
#EVAL_FIXTURE_DIR=/absolute/path/to/backend/eval/fixtures

#MEETING_DATABASE_PATH=/absolute/path/to/meetings.sqlite3
#RECORDINGS_DIR=/absolute/path/to/recordings
#TRANSCRIPT_EXPORT_DIR=/absolute/path/to/transcripts

# ---- Google Cloud / Firebase deployment -----------------------------------
# Firestore is an optional durable mirror. SQLite remains the local ordered
# working store. Cloud Run should enable both flags so persistence failures are
# visible instead of silently producing an incomplete demo.
FIRESTORE_ENABLED=false
FIRESTORE_REQUIRED=false
# GOOGLE_CLOUD_PROJECT is injected/set by the Cloud Run deployment.
# GOOGLE_CLOUD_PROJECT=your-project-id
FIRESTORE_DATABASE=(default)
FIRESTORE_MEETINGS_COLLECTION=meetings
# Writable runtime paths used by the Cloud Run deployment:
# STORAGE_DIR=/tmp/ai-meeting-draw/storage
# MEETING_DATABASE_PATH=/tmp/ai-meeting-draw/data/meetings.sqlite3
# RECORDINGS_DIR=/tmp/ai-meeting-draw/recordings
# TRANSCRIPT_EXPORT_DIR=/tmp/ai-meeting-draw/transcripts
