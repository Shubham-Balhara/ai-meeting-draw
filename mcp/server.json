{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "ai-meeting-draw",
  "title": "AI Meeting Draw",
  "description": "Read, create and edit open-source AI Meeting Draw diagram boards, browse versions and comment.",
  "version": "1.0.0",
  "websiteUrl": "http://127.0.0.1:8000",
  "repository": {
    "url": "https://github.com/OWNER/ai-meeting-draw",
    "source": "github",
    "id": "1294749108",
    "subfolder": "mcp"
  },
  "icons": [
    {
      "src": "http://127.0.0.1:8000/logo-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    },
    {
      "src": "http://127.0.0.1:8000/favicon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "packages": [
    {
      "registryType": "mcpb",
      "identifier": "https://github.com/OWNER/ai-meeting-draw/releases/download/mcpb-v1.0.0/ai-meeting-draw.mcpb",
      "fileSha256": "12d4b05300b53cee0e75bae30fbd7e23df60f277aa752665b93e2d2947fc9147",
      "version": "1.0.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "AI_MEETING_DRAW_BASE_URL",
          "description": "http(s) origin of the AI Meeting Draw instance. Set it to your own origin when self-hosting.",
          "default": "http://127.0.0.1:8000",
          "isRequired": false
        },
        {
          "name": "AI_MEETING_DRAW_AGENT_NAME",
          "description": "Display name on the agent's comments and version snapshots (max 40 chars).",
          "default": "MCP agent",
          "isRequired": false
        },
        {
          "name": "AI_MEETING_DRAW_AI_PROVIDER",
          "description": "Optional bring-your-own-key provider for generate_diagram.",
          "choices": [
            "claude",
            "openai",
            "gemini",
            "openrouter",
            "custom"
          ],
          "isRequired": false
        },
        {
          "name": "AI_MEETING_DRAW_AI_KEY",
          "description": "Optional AI provider key, sent only to AI_MEETING_DRAW_BASE_URL per call and never stored.",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "AI_MEETING_DRAW_AI_MODEL",
          "description": "Optional model override for generate_diagram.",
          "isRequired": false
        }
      ]
    }
  ]
}
